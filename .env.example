# ============================================================================
# DARKNOTE CONTROL CENTER — environment
# Copy to .env.local (development) or set these in your host's secret store.
# Never commit real values. Nothing here is exposed to the browser.
# ============================================================================

# --- Database (Neon PostgreSQL) ---------------------------------------------
# The primary persistent store. Use the POOLED connection string from the Neon
# dashboard (host contains "-pooler"): on serverless, PgBouncer multiplexes one
# client connection onto fewer server connections, which is what keeps the
# project inside Neon's connection limit.
# If this is left empty the app falls back to an embedded PGlite database
# inside DARKNOTE_DATA_DIR — fine for local evaluation and the test suite, never
# for production (a serverless filesystem is ephemeral).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/darknote?sslmode=require
# require (default) | no-verify | disable
DATABASE_SSL=require
# postgres (node-postgres over TCP, the default) | neon (@neondatabase/serverless
# over a WebSocket) | pglite (embedded, local only) | auto
DARKNOTE_DB_DRIVER=auto
# Connections per process. 1 is right on serverless; a long-running `next start`
# can use up to 20.
# DARKNOTE_DB_POOL=1
# Schema ownership.
#   auto   (default) apply pending migrations on boot when one long-running
#          process owns the schema (local, a container, `next start`);
#          VERIFY ONLY on a serverless platform in production, where every
#          instance is a fresh process and a request must never migrate.
#   verify never apply; report pending migrations as a warning and in /api/health.
#   always apply on boot — correct for exactly one long-running instance.
#   never  never apply, and refuse to start while a migration is pending.
# On Vercel/Neon: run `npm run db:migrate` once from a deploy step (or a single
# machine) and leave this at `auto`, which behaves as `verify` there.
# DARKNOTE_DB_MIGRATE=auto
# How long a second instance waits for the migration gate before reporting that
# another process is migrating. Default 15000 ms.
# DARKNOTE_MIGRATION_LOCK_WAIT_MS=15000
# How long a failed database initialisation is remembered before another attempt.
# Serves a burst of requests the same answer instead of retrying per request.
# Set to 0 to retry on every request. Default 3000 ms.
# DARKNOTE_DB_RETRY_MS=3000

# --- Application secret ------------------------------------------------------
# Signs sessions and encrypts stored Pterodactyl API keys (AES-256-GCM).
# MUST be stable: changing it invalidates sessions and makes stored panel keys
# unreadable (you would have to re-enter them).
# Generate: openssl rand -base64 48
DARKNOTE_SECRET=

# --- Serverless scheduler (Vercel) -------------------------------------------
# On a serverless host the in-process timers cannot survive a response, so
# /api/cron/tick (driven by Vercel Cron, see vercel.json) drains the GitHub push
# queue and polls synchronized branches instead. Vercel sends
# `Authorization: Bearer <CRON_SECRET>` for that path.
# Without this value the endpoint answers 503 and scheduled work stays off —
# it never runs unauthenticated. Generate: openssl rand -hex 32
CRON_SECRET=

# --- First-run administrator ------------------------------------------------
# Used once to create the first owner account when the database has no users.
DARKNOTE_ADMIN_EMAIL=you@example.com
DARKNOTE_ADMIN_PASSWORD=
DARKNOTE_ADMIN_NAME=Administrator

# Gate for the browser first-run setup form (POST /api/auth/bootstrap).
# Required for that flow; without it the form is closed and you must use
# `npm run create-admin` or the DARKNOTE_ADMIN_* bootstrap above.
# SETUP_TOKEN= is accepted as an alias. Treat this like a password.
DARKNOTE_SETUP_TOKEN=

# --- Runtime ----------------------------------------------------------------
DARKNOTE_DATA_DIR=.data
DARKNOTE_APP_URL=http://localhost:3000
# 12 hours by default
DARKNOTE_SESSION_HOURS=12
# Failed logins allowed per window, per email/IP
DARKNOTE_LOGIN_MAX_ATTEMPTS=8
DARKNOTE_LOGIN_WINDOW_MINUTES=15
# Set to 1 only behind a trusted reverse proxy that sets x-forwarded-for
DARKNOTE_TRUST_PROXY=0

# --- Safety rails -----------------------------------------------------------
DARKNOTE_MAX_INDEX_FILES=4000
DARKNOTE_MAX_INDEX_DEPTH=10
# Hard ceiling for any single download/backup read (bytes)
DARKNOTE_MAX_DOWNLOAD_BYTES=100663296
# Process-wide ceiling for opening/editing one text file (bytes, default 64 MB).
# Per-server limits are set in Settings and can never exceed this.
DARKNOTE_MAX_EDITOR_BYTES=67108864
# Slice size for chunked editor reads and draft uploads (bytes, 64 KB - 8 MB)
DARKNOTE_EDITOR_CHUNK_BYTES=524288
# Files above this size are not mirrored into the SQL content cache (bytes)
DARKNOTE_MAX_SQL_CACHE_BYTES=1048576
DARKNOTE_MAX_SEARCH_RESULTS=400

# --- Code editor / large files ----------------------------------------------
# Process-wide ceiling for opening and editing one text file. The per-server
# "Editor file limit" in Admin Settings may be lower but never higher.
# Default 64 MB (67108864). Files above the effective limit are rejected with a
# clear 413 instead of being truncated.
DARKNOTE_MAX_EDITOR_BYTES=67108864
# Size of one read/upload slice the browser exchanges with the server.
# Default 512 KB (524288); allowed range 64 KB – 8 MB.
DARKNOTE_EDITOR_CHUNK_BYTES=524288
# Files larger than this are not mirrored into the SQL content cache; they are
# read from the panel and cached in memory instead. Default 1 MB.
DARKNOTE_MAX_SQL_CACHE_BYTES=1048576

# --- WhatsApp status probe (optional) ----------------------------------------
# The bot has no health endpoint, so WhatsApp state is read from its own console
# events. To make it an authoritative process probe, have the bot write
# {"whatsapp":"connected","startedAt":"..."} to a file and point this at it.
# DARKNOTE_BOT_STATUS_PATH=/status.json

# --- WhatsApp status probe (optional) --------------------------------------
# Path on the Pterodactyl server to a JSON file the bot writes on every
# connection update: {"whatsapp":"connected|disconnected","startedAt":"ISO"}.
# When set and fresh, this is authoritative; otherwise the control center uses
# the bot process's own console connection events. Leave empty to disable.
# DARKNOTE_BOT_STATUS_PATH=/data/status.json

# --- Retention (optional) ---------------------------------------------------
# Pruned by `npm run db:maintenance` only — never by a page request.
# DARKNOTE_RETAIN_LOGIN_ATTEMPTS_DAYS=30
# DARKNOTE_RETAIN_ERRORS_DAYS=120
# DARKNOTE_RETAIN_DOWNLOADS_DAYS=90
# DARKNOTE_RETAIN_SYNC_EVENTS_DAYS=60
# DARKNOTE_RETAIN_HEALTH_DAYS=30
# 0 keeps the audit trail forever (default). Setting it deletes evidence — be sure.
# DARKNOTE_RETAIN_AUDIT_DAYS=0

# --- Scheduled reconciliation (optional) -----------------------------------
# Pterodactyl exposes no file-change events, so changes made in the panel are
# detected by polling. Enable the in-process scheduler only on a long-running
# `next start` deployment; on serverless, call POST /api/servers/{id}/sync from
# an external cron instead.
ENABLE_SCHEDULED_SCAN=false
SCAN_INTERVAL_SECONDS=300

# --- GitHub integration (optional) -----------------------------------------
# The GitHub token itself is NOT an environment variable: it is entered in
# Admin Settings -> GitHub Connection, verified against the GitHub API, then
# encrypted with DARKNOTE_SECRET before it is stored. Only these knobs live here.
#
# Where the panel talks to GitHub (override for GitHub Enterprise or tests).
# DARKNOTE_GITHUB_API_BASE=https://api.github.com
# DARKNOTE_GITHUB_OAUTH_BASE=https://github.com
#
# Public URL of this deployment, used to build the OAuth callback
# (default: the origin of the incoming request).
# DARKNOTE_APP_URL=https://darknote.example.com
# DARKNOTE_GITHUB_OAUTH_REDIRECT=https://darknote.example.com/api/github/oauth/callback
#
# The debounced synchronization queue drains from an in-process timer. Set this
# to 1 when timers are not reliable (serverless): the panel then drains it from
# the pending-project views through POST /api/github/sync/tick.
# DARKNOTE_DISABLE_GITHUB_WORKER=0

# ---------------------------------------------------------------------------
# NOT configured here on purpose:
#
# The Pterodactyl panel URL, server identifier and Client API key are NOT
# environment variables. They are entered per server in Admin Settings, then
# encrypted with DARKNOTE_SECRET before being written to the database, and are
# never returned to the browser.
# ---------------------------------------------------------------------------
