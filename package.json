{
  "name": "darknote-control-center",
  "version": "1.0.0",
  "private": true,
  "description": "DARKNOTE CONTROL CENTER - remote administration platform for the existing Darknote WhatsApp bot on Pterodactyl",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register-hooks.mjs --experimental-strip-types --test tests/*.test.ts",
    "verify:github": "node --import ./tests/register-hooks.mjs --experimental-strip-types scripts/verify-github.ts",
    "db:check": "node --env-file=.env.local --import ./tests/register-hooks.mjs --experimental-strip-types scripts/db-check.ts",
    "create-admin": "node --env-file=.env.local --import ./tests/register-hooks.mjs --experimental-strip-types scripts/create-admin.ts",
    "monaco:copy": "node scripts/copy-monaco.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "postinstall": "node scripts/copy-monaco.mjs",
    "predev": "node scripts/copy-monaco.mjs",
    "prebuild": "node scripts/copy-monaco.mjs",
    "prestart": "node scripts/copy-monaco.mjs",
    "db:migrate": "node --env-file=.env.local --import ./tests/register-hooks.mjs --experimental-strip-types scripts/migrate.ts",
    "db:status": "node --env-file=.env.local --import ./tests/register-hooks.mjs --experimental-strip-types scripts/migrate.ts -- --status",
    "db:maintenance": "node --env-file=.env.local --import ./tests/register-hooks.mjs --experimental-strip-types scripts/db-maintenance.ts",
    "db:backup": "node --env-file=.env.local --import ./tests/register-hooks.mjs --experimental-strip-types scripts/db-maintenance.ts --backup",
    "db:restore": "node --env-file=.env.local --import ./tests/register-hooks.mjs --experimental-strip-types scripts/db-maintenance.ts restore"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@monaco-editor/react": "4.7.0",
    "@neondatabase/serverless": "^1.2.1",
    "acorn": "8.15.0",
    "acorn-walk": "8.3.4",
    "bcryptjs": "3.0.2",
    "clsx": "2.1.1",
    "diff": "8.0.2",
    "fflate": "0.8.2",
    "lucide-react": "^0.544.0",
    "monaco-editor": "0.52.2",
    "next": "15.5.29",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "ws": "8.18.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "3.0.0",
    "@types/diff": "7.0.2",
    "@types/node": "22.15.3",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/ws": "8.18.1",
    "autoprefixer": "10.4.21",
    "embedded-postgres": "^18.7.0-beta.19",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2"
  }
}
